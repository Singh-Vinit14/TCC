rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /players/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
